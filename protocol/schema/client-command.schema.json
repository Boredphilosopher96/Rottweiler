  "$defs": {
    "CommandMeta": {
      "description": "Metadata common to commands from all client transports.",
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "client_id": {
          "$ref": "#/$defs/ClientId"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "protocol_version",
        "client_id",
        "request_id"
      ]
    },
    "ClientId": {
      "description": "Stable identifier of a connected client.",
      "type": "string"
    },
    "RequestId": {
      "description": "Client-generated identifier used to correlate a command.",
      "type": "string"
    },
    "ModelAlias": {
      "description": "Provider-blind model alias resolved by the engine router.",
      "type": "string"
    },
    "SessionId": {
      "description": "Stable identifier of an engine session.",
      "type": "string"
    },
    "SequenceId": {
      "description": "Monotonic per-session sequence encoded as a decimal string on the wire.",
      "type": "string"
    },
    "ClientRole": {
      "description": "Whether a client mutates the session or only observes it.",
      "type": "string",
      "enum": [
        "driver",
        "observer"
      ]
    },
    "Attachment": {
      "description": "User-provided content attached to a message.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "source_path": {
          "description": "Optional normalized workspace-relative source path. Local absolute paths\nnever cross the client protocol; their in-band content may still be\nattached under a safe basename.",
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/AttachmentData"
        }
      },
      "required": [
        "name",
        "media_type",
        "data"
      ]
    },
    "AttachmentData": {
      "description": "In-band attachment data; protocol messages never require shared files.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "inline_base64"
            }
          },
          "required": [
            "type",
            "data"
          ]
        }
      ]
    },
    "ToolCallId": {
      "description": "Stable identifier assigned to a model tool call.",
      "type": "string"
    },
    "ApprovalDecision": {
      "description": "A driver's decision at the permission chokepoint.",
      "type": "string",
      "enum": [
        "allow_once",
        "allow_session",
        "allow_project",
        "deny"
      ]
    },
    "ApprovalBinding": {
      "description": "Optional structured unified diff attached to a mutating-tool approval.",
      "type": "object",
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "arguments_hash": {
          "type": "string"
        },
        "base_hash": {
          "type": "string"
        },
        "diff_hash": {
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "arguments_hash",
        "base_hash",
        "diff_hash"
      ]
    },
    "PlanDecision": {
      "description": "Driver response to a submitted plan.",
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "QuestionId": {
      "description": "Stable identifier of an interactive question.",
      "type": "string"
    },
    "Answer": {
      "description": "One answer returned for a question entry.",
      "type": "object",
      "properties": {
        "question_id": {
          "$ref": "#/$defs/QuestionId"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "question_id",
        "values"
      ]
    },
    "ModeId": {
      "description": "Open identifier of a built-in or extension-provided mode.",
      "type": "string"
    },
    "TurnId": {
      "description": "Stable identifier of a conversation turn.",
      "type": "string"
    },
    "RewindTarget": {
      "description": "Rewind destination selected by a client.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "turn_id": {
              "$ref": "#/$defs/TurnId"
            },
            "type": {
              "type": "string",
              "const": "turn"
            }
          },
          "required": [
            "type",
            "turn_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "checkpoint_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "checkpoint"
            }
          },
          "required": [
            "type",
            "checkpoint_id"
          ]
        }
      ]
    },
    "ShellId": {
      "description": "Engine-generated identifier of one foreground user shell.",
      "type": "string"
    },
    "ContextItemId": {
      "description": "Stable identifier of one assembled context item.",
      "type": "string"
    },
    "ReviewFileDecision": {
      "description": "Driver decision for one file in the cumulative session review.",
      "type": "string",
      "enum": [
        "accept",
        "revert"
      ]
    },
    "McpEnvironmentEntry": {
      "description": "One explicit environment entry for a stdio MCP server.\n\nThe value is carried on the authenticated command wire but never exposed by\ndebug formatting.",
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ]
    },
    "PermissionAction": {
      "description": "Permission decision exposed on the interactive protocol without coupling\nclients to configuration-file types.",
      "type": "string",
      "enum": [
        "ask",
        "allow",
        "deny"
      ]
    },
    "TranscriptFormat": {
      "description": "Stable transcript formats shared by CLI and authenticated clients.",
      "type": "string",
      "enum": [
        "markdown",
        "html",
        "json"
      ]
    },
    "PermissionApprovalScope": {
      "description": "Scope of a remembered exact approval.",
      "type": "string",
      "enum": [
        "session",
        "project"
      ]
    },
    "ProviderAuthAttemptId": {
      "description": "Connection-scoped identifier of one provider authentication attempt.",
      "type": "string"
    },
    "SubagentId": {
      "description": "Stable identifier of a child agent session.",
      "type": "string"
    }
  }
}
