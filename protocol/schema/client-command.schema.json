{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientCommand",
  "description": "Commands accepted by the headless engine from any client.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/$defs/CommandMeta"
        },
        "cwd": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelAlias"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "type": "string",
          "const": "create_session"
        }
      },
      "required": [
        "type",
        "meta",
        "cwd"
      ]
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/$defs/CommandMeta"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "last_seen_sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequenceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/ClientRole"
        },
        "type": {
          "type": "string",
          "const": "resume_session"
        }
      },
      "required": [
        "type",
        "meta",
        "session_id",
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/$defs/CommandMeta"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "last_seen_sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequenceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/ClientRole"
        },
        "type": {
          "type": "string",
          "const": "attach_session"
        }
      },
      "required": [
        "type",
        "meta",
        "session_id",
        "role"
      ]
    },
    {
      "type": "object",
      "properties": {
        "meta": {
          "$ref": "#/$defs/CommandMeta"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "content": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attachment"
          }
        },
        "type": {
          "type": "string",
          "const": "send_message"
        }
      },
      "required": [
        "type",
        "meta",
        "session_id",
        "content",
        "attachments"
      ]
    },
    {
      "type": "object",
