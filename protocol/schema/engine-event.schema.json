  "$defs": {
    "CommandAckMeta": {
      "description": "Metadata for immediate command acknowledgements before session sequencing.",
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "client_id": {
          "$ref": "#/$defs/ClientId"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "emitted_at": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "client_id",
        "request_id",
        "emitted_at"
      ]
    },
    "ClientId": {
      "description": "Stable identifier of a connected client.",
      "type": "string"
    },
    "RequestId": {
      "description": "Client-generated identifier used to correlate a command.",
      "type": "string"
    },
    "SessionId": {
      "description": "Stable identifier of an engine session.",
      "type": "string"
    },
    "CommandOutcome": {
      "description": "Immediate disposition of a client command, delivered on the event channel.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/EngineError"
            },
            "type": {
              "type": "string",
              "const": "rejected"
            }
          },
          "required": [
            "type",
            "error"
          ]
        }
      ]
    },
    "EngineError": {
      "description": "Actionable client-safe error payload.",
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/EngineErrorCategory"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": true
      },
      "required": [
        "category",
        "code",
        "message",
        "retryable"
      ]
    },
    "EngineErrorCategory": {
      "description": "Stable error categories used across engine boundaries.",
      "type": "string",
      "enum": [
        "provider",
        "tool",
        "sandbox",
        "config",
        "extension",
        "protocol",
        "internal"
      ]
    },
    "EventMeta": {
      "description": "Metadata common to persisted and streamed events.",
      "type": "object",
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "sequence_id": {
          "$ref": "#/$defs/SequenceId"
        },
        "emitted_at": {
          "type": "string"
        },
        "caused_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocol_version",
        "session_id",
        "sequence_id",
        "emitted_at"
      ]
    },
    "SequenceId": {
      "description": "Monotonic per-session sequence encoded as a decimal string on the wire.",
      "type": "string"
    },
    "Attachment": {
      "description": "User-provided content attached to a message.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/AttachmentData"
        }
      },
      "required": [
        "name",
        "media_type",
        "data"
      ]
    },
    "AttachmentData": {
      "description": "In-band attachment data; protocol messages never require shared files.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "inline_base64"
            }
          },
          "required": [
            "type",
            "data"
          ]
        }
      ]
    },
    "Turn": {
      "description": "One conversation turn in the internal message representation.",
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "meta": {
          "$ref": "#/$defs/TurnMeta"
        }
      },
      "required": [
        "role",
        "blocks",
        "meta"
      ]
    },
    "Role": {
      "description": "A provider-neutral role in the conversation IR.",
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "Block": {
      "description": "A provider-neutral content block.",
      "oneOf": [
        {
