{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolOutput",
  "description": "Provider-neutral output produced by a tool.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "text"
        }
      },
      "required": [
        "type",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "value": true,
        "type": {
          "type": "string",
          "const": "structured"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolOutputPart"
          }
        },
        "type": {
          "type": "string",
          "const": "mixed"
        }
      },
      "required": [
        "type",
        "parts"
      ]
    }
  ],
  "$defs": {
    "ToolOutputPart": {
      "description": "One part of a mixed tool result.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": true,
            "type": {
              "type": "string",
              "const": "structured"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/ImageRef"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "media_type",
            "data"
          ]
        }
      ]
    },
    "ImageRef": {
      "description": "An image reference that does not assume a filesystem shared with a client.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "inline_base64"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "url"
            }
          },
          "required": [
            "type",
            "url"
          ]
        }
      ]
    }
  }
}
