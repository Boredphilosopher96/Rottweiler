cask "rottweiler" do
  version "@VERSION@"
  sha256 "@DARWIN_ARM64_SHA256@"

  url "@DARWIN_ARM64_URL@"
  name "Rottweiler"
  desc "Provider-blind coding-agent harness with an OpenTUI frontend"
  homepage "https://github.com/@HOMEPAGE_REPOSITORY@"

  depends_on arch: :arm64

  binary "#{staged_path}/@DARWIN_ARM64_BINARY_ROOT@/bin/rw", target: "rw"

  # Pre-v1 archives are checksum-verified but not yet Apple-notarized. Remove
  # quarantine before the first launch so Gatekeeper does not cache a rejected
  # assessment for the extracted inode.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{staged_path}/@DARWIN_ARM64_QUARANTINE_ROOT@"]
  end

  caveats <<~EOS
    This pre-v1 CLI is not Apple-notarized. The Cask removes quarantine only
    after Homebrew verifies the release archive's SHA-256 checksum.
  EOS
end
