{
  "name": "@rottweiler/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test --max-concurrency=1 --path-ignore-patterns='test/perf/**'",
    "test:perf": "bun test test/perf/m4-transport-performance.test.ts && bun test test/perf/performance.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@tree-sitter-grammars/tree-sitter-lua": "0.4.1",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-css": "0.25.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-html": "0.23.2",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-make": "1.1.1",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "patchedDependencies": {
    "bun-ffi-structs@0.2.4": "patches/bun-ffi-structs@0.2.4.patch",
    "@opentui/core@0.4.5": "patches/@opentui%2Fcore@0.4.5.patch"
  }
}
