{
  "name": "@rottweiler/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test --max-concurrency=1 --path-ignore-patterns='test/perf/**'",
    "test:perf": "bun test test/perf/m4-transport-performance.test.ts && bun test test/perf/performance.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.4.3",
    "beautiful-mermaid": "1.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "patchedDependencies": {
    "bun-ffi-structs@0.2.4": "patches/bun-ffi-structs@0.2.4.patch",
    "@opentui/core@0.4.3": "patches/@opentui%2Fcore@0.4.3.patch"
  }
}
