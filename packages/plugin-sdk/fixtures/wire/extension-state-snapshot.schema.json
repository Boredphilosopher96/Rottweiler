{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionStateSnapshot",
  "description": "A bounded projection of one namespace at a captured journal prefix.",
  "type": "object",
  "properties": {
    "revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/SequenceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtensionStateEntry"
      }
    },
    "acknowledged": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionDeliveryCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery_start": {
      "description": "Host-selected lower bound of this session's delivery stream. A fork\nstarts after its inherited prefix instead of redelivering parent effects.",
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionDeliveryCursor"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "entries",
    "acknowledged",
    "delivery_start"
  ],
  "$comment": "// @generated by cargo xtask codegen; do not edit by hand.",
  "$defs": {
    "SequenceId": {
      "description": "Monotonic per-session sequence encoded as a decimal string on the wire.",
      "type": "string"
    },
    "ExtensionStateEntry": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": true
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ]
    },
    "ExtensionDeliveryCursor": {
      "description": "The journal identity of one delivered event, independent of transport retries.",
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "sequence": {
          "$ref": "#/$defs/SequenceId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "sequence"
      ]
    },
    "SessionId": {
      "description": "Stable identifier of an engine session.",
      "type": "string"
    }
  }
}
