{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionEventNotice",
  "type": "object",
  "properties": {
    "cursor": {
      "$ref": "#/$defs/ExtensionDeliveryCursor"
    },
    "event": {
      "$ref": "#/$defs/ExtensionEventKind"
    },
    "state_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/SequenceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "$ref": "#/$defs/ExtensionEventContent"
    }
  },
  "additionalProperties": false,
  "required": [
    "cursor",
    "event",
    "state_revision",
    "content"
  ],
  "$comment": "// @generated by cargo xtask codegen; do not edit by hand.",
  "$defs": {
    "ExtensionDeliveryCursor": {
      "description": "The journal identity of one delivered event, independent of transport retries.",
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "sequence": {
          "$ref": "#/$defs/SequenceId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "sequence"
      ]
    },
    "SessionId": {
      "description": "Stable identifier of an engine session.",
      "type": "string"
    },
    "SequenceId": {
      "description": "Monotonic per-session sequence encoded as a decimal string on the wire.",
      "type": "string"
    },
    "ExtensionEventKind": {
      "type": "string",
      "enum": [
        "session_created",
        "workspace_roots_changed",
        "user_message_accepted",
        "session_title_updated",
        "conversation_rewound",
        "turn_started",
        "tool_call_started",
        "tool_call_finished",
        "turn_finished",
        "compaction_finished",
        "subagent_spawned",
        "subagent_finished",
        "mode_changed",
        "model_changed",
        "hook_failed",
        "command_finished",
        "driver_changed",
        "message_queued",
        "queued_message_removed",
        "queued_messages_cleared",
        "plugin_message_injected",
        "plugin_status_changed",
        "ui_notification",
        "text_delta",
        "thinking_delta",
        "citation_delta",
        "tool_approval_needed",
        "tool_diff_ready",
        "tool_output_delta",
        "question_asked",
        "question_answered",
        "context_usage_updated",
        "budget_status_changed",
        "compaction_started",
        "compaction_attempt_started",
        "compaction_text_delta",
        "compaction_thinking_delta",
        "compaction_attempt_finished",
        "compaction_failed",
        "subagent_progress",
        "tool_output_pruned",
        "permission_mode_changed",
        "plan_submitted",
        "plan_reviewed",
        "model_context_cleared",
        "context_item_pinned",
        "context_item_evicted",
        "user_shell_state_changed",
        "guard_triggered",
        "error"
      ]
    },
    "ExtensionEventContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": true,
            "storage": {
              "type": "string",
              "const": "inline"
            }
          },
          "additionalProperties": false,
          "required": [
            "storage",
            "data"
          ]
        },
        {
          "description": "Only the active delivery cursor authorizes source reads. The source is\nredacted canonical event JSON, retained until delivery settles.",
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint32",
              "minimum": 1,
              "maximum": 33554432
            },
            "storage": {
              "type": "string",
              "const": "source"
            }
          },
          "additionalProperties": false,
          "required": [
            "storage",
            "bytes"
          ]
        }
      ]
    }
  }
}
