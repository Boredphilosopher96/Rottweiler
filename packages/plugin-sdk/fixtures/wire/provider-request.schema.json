{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderRequest",
  "description": "A provider-neutral request assembled by the engine.",
  "type": "object",
  "properties": {
    "model": {
      "description": "Provider-local model name. The router replaces aliases before dispatch.",
      "type": "string"
    },
    "turns": {
      "description": "Conversation in Rottweiler's shared message IR.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Turn"
      }
    },
    "tools": {
      "description": "Function tools exposed for this turn.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      }
    },
    "tool_choice": {
      "description": "Whether the model may, must, must not, or must specifically call a tool.",
      "$ref": "#/$defs/ToolChoice"
    },
    "max_output_tokens": {
      "description": "Maximum number of output tokens.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "temperature": {
      "description": "Optional sampling temperature.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "thinking": {
      "description": "Provider-independent reasoning control.",
      "$ref": "#/$defs/ThinkingLevel"
    },
    "cache_hint": {
      "description": "Stable-prefix boundary assembled by the provider-neutral context engine.",
      "anyOf": [
        {
          "$ref": "#/$defs/CacheHint"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "model",
    "turns",
    "tools",
    "tool_choice",
    "max_output_tokens",
    "temperature",
    "thinking",
    "cache_hint"
  ],
  "$comment": "// @generated by cargo xtask codegen; do not edit by hand.",
  "$defs": {
    "Turn": {
      "description": "One conversation turn in the internal message representation.",
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/Role"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "meta": {
          "$ref": "#/$defs/TurnMeta"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "blocks",
        "meta"
      ]
    },
    "Role": {
      "description": "A provider-neutral role in the conversation IR.",
      "type": "string",
      "enum": [
        "system",
        "user",
        "assistant",
        "tool"
      ]
    },
    "Block": {
      "description": "A provider-neutral content block.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "signature": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "thinking"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ToolCallId"
            },
            "name": {
              "type": "string"
            },
            "args": true,
            "type": {
              "type": "string",
              "const": "tool_call"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "name",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/ToolCallId"
            },
            "output": {
              "$ref": "#/$defs/ToolOutput"
            },
            "is_error": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "tool_result"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "output",
            "is_error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/ImageRef"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "media_type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "excerpt": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "citation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "uri"
          ]
        }
      ]
    },
    "ToolCallId": {
      "description": "Stable identifier assigned to a model tool call.",
      "type": "string"
    },
    "ToolOutput": {
      "description": "Provider-neutral output produced by a tool.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": true,
            "type": {
              "type": "string",
              "const": "structured"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ToolOutputPart"
              }
            },
            "type": {
              "type": "string",
              "const": "mixed"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "parts"
          ]
        }
      ]
    },
    "ToolOutputPart": {
      "description": "One part of a mixed tool result.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "value": true,
            "type": {
              "type": "string",
              "const": "structured"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/ImageRef"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "media_type",
            "data"
          ]
        }
      ]
    },
    "ImageRef": {
      "description": "An image reference that does not assume a filesystem shared with a client.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "inline_base64"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "url"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "url"
          ]
        }
      ]
    },
    "TurnMeta": {
      "description": "Metadata whose meaning is independent of a provider adapter.",
      "type": "object",
      "properties": {
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "summary": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "synthetic",
        "summary"
      ]
    },
    "ToolDefinition": {
      "description": "A function tool definition.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Tool name presented to the model.",
          "type": "string"
        },
        "description": {
          "description": "Human-readable behavior summary.",
          "type": "string"
        },
        "input_schema": {
          "description": "JSON Schema accepted by the tool."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "input_schema"
      ]
    },
    "ToolChoice": {
      "description": "Provider-neutral tool selection policy.\n\nAdapters translate this into each provider's wire shape. A named choice is\nvalidated against [`ProviderRequest::tools`] before a request is sent.",
      "oneOf": [
        {
          "description": "The model may answer normally or call any exposed tool.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "auto"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "description": "The model must call at least one exposed tool.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "required"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "description": "The model must not call a tool, even when tools are exposed.",
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "none"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode"
          ]
        },
        {
          "description": "The model must call this exact function tool.",
          "type": "object",
          "properties": {
            "name": {
              "description": "Name of a function present in [`ProviderRequest::tools`].",
              "type": "string"
            },
            "mode": {
              "type": "string",
              "const": "named"
            }
          },
          "additionalProperties": false,
          "required": [
            "mode",
            "name"
          ]
        }
      ]
    },
    "ThinkingLevel": {
      "description": "Provider-neutral thinking effort selected by a model alias or session.",
      "oneOf": [
        {
          "description": "Do not request provider reasoning output.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "Prefer the provider's least expensive reasoning mode.",
          "type": "string",
          "const": "low"
        },
        {
          "description": "Prefer a balanced reasoning mode.",
          "type": "string",
          "const": "medium"
        },
        {
          "description": "Prefer the provider's strongest reasoning mode.",
          "type": "string",
          "const": "high"
        }
      ]
    },
    "CacheHint": {
      "description": "Provider-neutral stable prompt prefix eligible for adapter cache mapping.",
      "type": "object",
      "properties": {
        "stable_prefix_turns": {
          "description": "Count of leading turns in the stable prefix.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tools_in_prefix": {
          "description": "Whether all tool definitions are part of that stable prefix.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "stable_prefix_turns",
        "tools_in_prefix"
      ]
    }
  }
}
