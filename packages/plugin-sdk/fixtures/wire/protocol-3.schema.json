{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rottweiler.dev/schema/plugin/protocol-3.json",
  "title": "Rottweiler Plugin API conformance fixture",
  "type": "object",
  "required": [
    "$comment",
    "protocol",
    "status",
    "framing",
    "limits",
    "methods",
    "initialize_request",
    "initialize_response",
    "provider_models_request",
    "provider_models_response",
    "provider_http_request",
    "provider_http_head",
    "provider_http_body",
    "provider_http_finished"
  ],
  "properties": {
    "protocol": {
      "const": 3
    },
    "status": {
      "const": "stable"
    },
    "framing": {
      "const": "newline-delimited-json-rpc-2.0"
    },
    "limits": {
      "type": "object",
      "required": [
        "max_frame_bytes",
        "max_provider_streams",
        "max_in_flight_requests",
        "provider_window_events",
        "provider_window_bytes",
        "control_queue_frames",
        "control_queue_bytes",
        "data_queue_bytes",
        "max_operation_duration_ms",
        "default_tool_idle_timeout_ms",
        "max_progress_message_chars",
        "max_progress_message_bytes",
        "max_progress_frame_bytes",
        "progress_interval_ms",
        "progress_burst",
        "max_manifest_bytes",
        "max_capabilities_per_kind",
        "max_name_bytes",
        "max_version_bytes",
        "max_description_bytes",
        "max_schema_bytes",
        "max_schema_depth",
        "max_model_tokens",
        "max_price_micros_usd"
      ],
      "properties": {
        "max_frame_bytes": {
          "const": 4194304
        },
        "max_manifest_bytes": {
          "const": 262144
        },
        "max_capabilities_per_kind": {
          "const": 256
        },
        "max_name_bytes": {
          "const": 128
        },
        "max_version_bytes": {
          "const": 64
        },
        "max_description_bytes": {
          "const": 16384
        },
        "max_schema_bytes": {
          "const": 65536
        },
        "max_schema_depth": {
          "const": 32
        },
        "max_model_tokens": {
          "const": 16777216
        },
        "max_price_micros_usd": {
          "const": 1000000000000
        },
        "max_provider_streams": {
          "const": 4
        },
        "max_in_flight_requests": {
          "const": 64
        },
        "provider_window_events": {
          "const": 64
        },
        "provider_window_bytes": {
          "const": 4194304
        },
        "control_queue_frames": {
          "const": 64
        },
        "control_queue_bytes": {
          "const": 16777216
        },
        "data_queue_bytes": {
          "const": 16777220
        },
        "max_operation_duration_ms": {
          "const": 300000
        },
        "default_tool_idle_timeout_ms": {
          "const": 90000
        },
        "max_progress_message_chars": {
          "const": 256
        },
        "max_progress_message_bytes": {
          "const": 1024
        },
        "max_progress_frame_bytes": {
          "const": 4096
        },
        "progress_interval_ms": {
          "const": 250
        },
        "progress_burst": {
          "const": 4
        }
      },
      "additionalProperties": false
    },
    "methods": {
      "type": "object"
    },
    "initialize_request": {
      "$ref": "#/$defs/request"
    },
    "initialize_response": {
      "$ref": "#/$defs/success"
    },
    "provider_models_request": {
      "$ref": "#/$defs/request"
    },
    "provider_models_response": {
      "$ref": "#/$defs/success"
    },
    "provider_http_request": {
      "$ref": "#/$defs/request"
    },
    "provider_http_head": {
      "$ref": "#/$defs/notification"
    },
    "provider_http_body": {
      "$ref": "#/$defs/notification"
    },
    "provider_http_finished": {
      "$ref": "#/$defs/notification"
    },
    "$comment": {
      "const": "@generated by cargo xtask codegen; do not edit by hand."
    },
    "tool_call_request": {
      "$ref": "#/$defs/request"
    },
    "tool_progress": {
      "$ref": "#/$defs/notification"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      ]
    },
    "request": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "params": true
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "result": true
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": [
        "jsonrpc",
        "method"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "params": true
      },
      "additionalProperties": false
    },
    "provider_capability": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$",
      "maxLength": 128
    },
    "provider_declaration": {
      "type": "object",
      "required": [
        "alias-prefix"
      ],
      "properties": {
        "alias-prefix": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+/$",
          "maxLength": 128
        },
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provider_capability"
          }
        },
        "credential-references": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provider_capability"
          }
        }
      },
      "additionalProperties": false
    },
    "model_capabilities": {
      "type": "object",
      "required": [
        "tool_calling",
        "vision",
        "thinking",
        "cache_breakpoints"
      ],
      "properties": {
        "tool_calling": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        },
        "thinking": {
          "type": "boolean"
        },
        "cache_breakpoints": {
          "enum": [
            "none",
            "explicit",
            "automatic"
          ]
        }
      },
      "additionalProperties": false
    },
    "pricing": {
      "type": "object",
      "required": [
        "input_per_million_micros_usd",
        "output_per_million_micros_usd"
      ],
      "properties": {
        "input_per_million_micros_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "output_per_million_micros_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cache_read_per_million_micros_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cache_write_per_million_micros_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "reasoning_per_million_micros_usd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capabilities": {
          "$ref": "#/$defs/model_capabilities"
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "pricing": {
          "$ref": "#/$defs/pricing"
        }
      },
      "additionalProperties": false
    },
    "provider_models_result": {
      "type": "object",
      "required": [
        "models"
      ],
      "properties": {
        "models": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": false
    },
    "operation_lifetime": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "OperationLifetime",
      "description": "Total time never renews. Valid progress may renew idle time within that total.",
      "type": "object",
      "properties": {
        "total_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 300000
        },
        "idle_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "additionalProperties": false,
      "required": [
        "total_ms",
        "idle_ms"
      ]
    },
    "ProgressAmount": {
      "description": "Optional bounded work-count observation. It cannot grant more execution time.",
      "type": "object",
      "properties": {
        "completed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "completed",
        "total"
      ]
    },
    "tool_progress": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "ToolProgress",
      "description": "Replaceable display state; never authoritative tool output or a durable record.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressAmount"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "message"
      ]
    },
    "initialize_params": {
      "properties": {
        "host": {
          "const": "rottweiler"
        }
      }
    }
  },
  "$comment": "@generated by cargo xtask codegen; do not edit by hand."
}
