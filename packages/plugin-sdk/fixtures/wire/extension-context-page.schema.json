{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionContextPage",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "restart"
        }
      },
      "additionalProperties": false,
      "required": [
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SequenceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtensionContextItem"
          },
          "maxItems": 128
        },
        "next_after_item_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-rw-max-utf8-bytes": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string",
          "const": "ready"
        }
      },
      "additionalProperties": false,
      "required": [
        "outcome",
        "sequence",
        "items",
        "next_after_item_id"
      ]
    }
  ],
  "$comment": "// @generated by cargo xtask codegen; do not edit by hand.",
  "$defs": {
    "SequenceId": {
      "description": "Monotonic per-session sequence encoded as a decimal string on the wire.",
      "type": "string"
    },
    "ExtensionContextItem": {
      "description": "Metadata only. Prompt bodies, tool outputs and machine-local paths are not exposed.",
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-rw-max-utf8-bytes": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "kind": {
          "$ref": "#/$defs/ContextItemKind"
        },
        "source": {
          "$ref": "#/$defs/ExtensionContextSource"
        },
        "estimated_tokens": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ContextItemState"
        }
      },
      "additionalProperties": false,
      "required": [
        "item_id",
        "kind",
        "source",
        "estimated_tokens",
        "state"
      ]
    },
    "ContextItemKind": {
      "description": "Semantic class of one assembled prompt item.",
      "type": "string",
      "enum": [
        "system",
        "tool_definitions",
        "project_instructions",
        "conversation",
        "tool_result",
        "pinned",
        "queued_message"
      ]
    },
    "ExtensionContextSource": {
      "type": "string",
      "enum": [
        "built_in",
        "project_file",
        "extension",
        "conversation",
        "user_pin",
        "client_queue",
        "tool_registry"
      ]
    },
    "ContextItemState": {
      "description": "Orthogonal surgery markers for one context item.",
      "type": "object",
      "properties": {
        "pinned": {
          "type": "boolean"
        },
        "evicted": {
          "type": "boolean"
        },
        "summarized": {
          "type": "boolean"
        },
        "pruned": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "pinned",
        "evicted",
        "summarized",
        "pruned"
      ]
    }
  }
}
