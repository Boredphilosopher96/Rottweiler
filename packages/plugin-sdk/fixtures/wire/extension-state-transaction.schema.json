{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionStateTransaction",
  "description": "One compare-and-swap against the host-bound plugin namespace.\nThe committed event sequence becomes its revision. An acknowledgement and\nits state changes share the same durable commit.",
  "type": "object",
  "properties": {
    "expected_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/SequenceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExtensionStateMutation"
      }
    },
    "acknowledged": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionDeliveryCursor"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "mutations",
    "acknowledged"
  ],
  "$comment": "// @generated by cargo xtask codegen; do not edit by hand.",
  "$defs": {
    "SequenceId": {
      "description": "Monotonic per-session sequence encoded as a decimal string on the wire.",
      "type": "string"
    },
    "ExtensionStateMutation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "value": true,
            "action": {
              "type": "string",
              "const": "set"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "key",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "const": "delete"
            }
          },
          "additionalProperties": false,
          "required": [
            "action",
            "key"
          ]
        }
      ]
    },
    "ExtensionDeliveryCursor": {
      "description": "The journal identity of one delivered event, independent of transport retries.",
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "sequence": {
          "$ref": "#/$defs/SequenceId"
        }
      },
      "additionalProperties": false,
      "required": [
        "session_id",
        "sequence"
      ]
    },
    "SessionId": {
      "description": "Stable identifier of an engine session.",
      "type": "string"
    }
  }
}
