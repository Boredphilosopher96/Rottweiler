{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderEvent",
  "description": "The normalized event stream consumed by the engine and replay harness.",
  "oneOf": [
    {
      "description": "Provider accepted the message and selected a concrete model.",
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "message_start"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "model"
      ]
    },
    {
      "description": "Visible assistant text.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "text_delta"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ]
    },
    {
      "description": "Hidden or summarized model reasoning.",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "thinking_delta"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content",
        "signature"
      ]
    },
    {
      "description": "Beginning of a function call.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "tool_call_start"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name"
      ]
    },
    {
      "description": "Incremental JSON argument bytes.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "json_fragment": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "tool_call_arguments_delta"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "json_fragment"
      ]
    },
    {
      "description": "Completed and parsed function arguments.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "arguments": true,
        "type": {
          "type": "string",
          "const": "tool_call_end"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "arguments"
      ]
    },
    {
      "description": "A source citation emitted by a provider-native response.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "end_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "citation"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "uri",
        "title",
        "start_index",
        "end_index"
      ]
    },
    {
      "description": "Latest usage totals for the response.",
      "type": "object",
      "properties": {
        "usage": {
          "$ref": "#/$defs/TokenUsage"
        },
        "type": {
          "type": "string",
          "const": "usage"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "usage"
      ]
    },
    {
      "description": "Terminal event.",
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/FinishReason"
        },
        "type": {
          "type": "string",
          "const": "finished"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "reason"
      ]
    }
  ],
  "$comment": "// @generated by cargo xtask codegen; do not edit by hand.",
  "$defs": {
    "TokenUsage": {
      "description": "Provider usage normalized across API families.",
      "type": "object",
      "properties": {
        "input_tokens": {
          "description": "Non-cached input tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "description": "Generated tokens.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "description": "Input tokens served from a prompt cache.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_write_tokens": {
          "description": "Input tokens written into a prompt cache.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reasoning_tokens": {
          "description": "Reasoning tokens when separately reported.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens"
      ]
    },
    "FinishReason": {
      "description": "Why a model stream ended.",
      "oneOf": [
        {
          "description": "Normal end of generation.",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "Output token limit reached.",
          "type": "string",
          "const": "length"
        },
        {
          "description": "The model requested one or more tools.",
          "type": "string",
          "const": "tool_calls"
        },
        {
          "description": "Provider content filter stopped the request.",
          "type": "string",
          "const": "content_filter"
        },
        {
          "description": "Provider-specific reason retained as an unknown category.",
          "type": "string",
          "const": "unknown"
        }
      ]
    }
  }
}
