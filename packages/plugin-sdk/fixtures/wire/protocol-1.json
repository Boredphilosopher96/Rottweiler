{
  "protocol": 1,
  "status": "frozen",
  "framing": "newline-delimited-json-rpc-2.0",
  "limits": {
    "max_frame_bytes": 4194304,
    "max_manifest_bytes": 262144,
    "max_capabilities_per_kind": 256,
    "max_name_bytes": 128,
    "max_version_bytes": 64,
    "max_description_bytes": 16384,
    "max_schema_bytes": 65536,
    "max_schema_depth": 32
  },
  "methods": {
    "initialize": "initialize",
    "toolCall": "tool/call",
    "commandExecute": "command/execute",
    "hookInvoke": "hook/invoke",
    "providerComplete": "provider/complete",
    "providerEvent": "provider/event",
    "providerCancel": "provider/cancel",
    "eventPublish": "event/publish",
    "injectMessage": "session/inject_message",
    "setStatus": "session/set_status",
    "notify": "ui/notify",
    "shutdown": "shutdown",
    "exit": "exit"
  },
  "initialize_request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
      "host": "rottweiler",
      "protocol": 1,
      "min_protocol": 1,
      "max_frame_bytes": 4194304
    }
  },
  "initialize_response": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
      "name": "wire-fixture",
      "version": "1.0.0",
      "protocol": 1,
      "capabilities": {
        "tools": [],
        "commands": [],
        "hooks": [],
        "providers": [],
        "event_subscriptions": ["TurnFinished"],
        "push": ["ui/notify"]
      }
    }
  },
  "provider_event_notification": {
    "jsonrpc": "2.0",
    "method": "provider/event",
    "params": {
      "request_id": 7,
      "event": { "type": "text_delta", "text": "hello" }
    }
  },
  "provider_complete_response": {
    "jsonrpc": "2.0",
    "id": 7,
    "result": null
  },
  "provider_cancel_notification": {
    "jsonrpc": "2.0",
    "method": "provider/cancel",
    "params": { "request_id": 7 }
  }
}
