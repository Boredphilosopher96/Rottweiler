{
  "name": "@rottweiler/plugin",
  "version": "0.1.4",
  "description": "Official TypeScript SDK for capability-bound Rottweiler plugins",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boredphilosopher96/Rottweiler.git",
    "directory": "packages/plugin-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    },
    "./protocol.json": "./fixtures/wire/protocol-2.json",
    "./protocol.schema.json": "./fixtures/wire/protocol-2.schema.json"
  },
  "bin": {
    "rottweiler-plugin-scaffold": "./dist/bin/scaffold.js"
  },
  "files": ["dist", "fixtures/scaffold", "fixtures/wire/protocol-2.json", "fixtures/wire/protocol-2.schema.json", "PROTOCOL.md", "README.md"],
  "scripts": {
    "build": "bun run build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
