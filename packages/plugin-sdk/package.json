{
  "name": "@rottweiler/plugin",
  "version": "0.1.4",
  "description": "Official TypeScript SDK for capability-bound Rottweiler plugins",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boredphilosopher96/Rottweiler.git",
    "directory": "packages/plugin-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "default": "./dist/scaffold.js"
    },
    "./protocol.json": "./fixtures/wire/protocol-3.json",
    "./protocol.schema.json": "./fixtures/wire/protocol-3.schema.json",
    "./hook-input.schema.json": "./fixtures/wire/hook-input.schema.json",
    "./hook-directive.schema.json": "./fixtures/wire/hook-directive.schema.json",
    "./provider-request.schema.json": "./fixtures/wire/provider-request.schema.json",
    "./provider-event.schema.json": "./fixtures/wire/provider-event.schema.json",
    "./extension-state-transaction.schema.json": "./fixtures/wire/extension-state-transaction.schema.json",
    "./extension-state-snapshot.schema.json": "./fixtures/wire/extension-state-snapshot.schema.json",
    "./extension-state-outcome.schema.json": "./fixtures/wire/extension-state-outcome.schema.json",
    "./extension-session-snapshot.schema.json": "./fixtures/wire/extension-session-snapshot.schema.json",
    "./extension-event-kind.schema.json": "./fixtures/wire/extension-event-kind.schema.json",
    "./extension-event-notice.schema.json": "./fixtures/wire/extension-event-notice.schema.json",
    "./extension-event-outcome.schema.json": "./fixtures/wire/extension-event-outcome.schema.json",
    "./extension-event-chunk.schema.json": "./fixtures/wire/extension-event-chunk.schema.json",
    "./ui-contribution.schema.json": "./fixtures/wire/ui-contribution.schema.json",
    "./extension-context-read.schema.json": "./fixtures/wire/extension-context-read.schema.json",
    "./extension-context-page.schema.json": "./fixtures/wire/extension-context-page.schema.json",
    "./extension-control.schema.json": "./fixtures/wire/extension-control.schema.json",
    "./extension-control-outcome.schema.json": "./fixtures/wire/extension-control-outcome.schema.json"
  },
  "bin": {
    "rottweiler-plugin-scaffold": "./dist/bin/scaffold.js"
  },
  "files": [
    "dist",
    "fixtures/scaffold",
    "fixtures/wire/protocol-3.json",
    "fixtures/wire/protocol-3.schema.json",
    "PROTOCOL.md",
    "README.md",
    "fixtures/wire/hook-input.schema.json",
    "fixtures/wire/hook-directive.schema.json",
    "fixtures/wire/provider-request.schema.json",
    "fixtures/wire/provider-event.schema.json",
    "fixtures/wire/extension-state-transaction.schema.json",
    "fixtures/wire/extension-state-snapshot.schema.json",
    "fixtures/wire/extension-state-outcome.schema.json",
    "fixtures/wire/extension-session-snapshot.schema.json",
    "fixtures/wire/extension-event-kind.schema.json",
    "fixtures/wire/extension-event-notice.schema.json",
    "fixtures/wire/extension-event-outcome.schema.json",
    "fixtures/wire/extension-event-chunk.schema.json",
    "fixtures/wire/ui-contribution.schema.json",
    "fixtures/wire/extension-context-read.schema.json",
    "fixtures/wire/extension-context-page.schema.json",
    "fixtures/wire/extension-control.schema.json",
    "fixtures/wire/extension-control-outcome.schema.json"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
