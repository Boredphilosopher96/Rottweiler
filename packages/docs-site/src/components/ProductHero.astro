---
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---

<section class="product-hero">
  <div class="hero-copy">
    <p class="release-chip"><span aria-hidden="true"></span> Local-first coding agent</p>
    <h1>Keep the agent fast.<br /><em>Keep yourself in control.</em></h1>
    <p class="hero-lede">
      Rottweiler is a local coding-agent harness with a Rust engine, a responsive
      terminal interface, durable sessions, explicit permissions, and one
      extension boundary for humans and automation.
    </p>
    <div class="hero-actions">
      <a class="primary-action" href={`${base}/docs/installation/`}>Install Rottweiler <span aria-hidden="true">→</span></a>
      <a class="secondary-action" href="https://github.com/Boredphilosopher96/Rottweiler">View source</a>
    </div>
    <div class="install-command" aria-label="Homebrew install command">
      <span aria-hidden="true">$</span>
      <code>brew install --cask Boredphilosopher96/tap/rottweiler</code>
      <button type="button" data-copy="brew install --cask Boredphilosopher96/tap/rottweiler" aria-label="Copy install command">Copy</button>
    </div>
  </div>
  <div class="hero-art">
    <img src={`${base}/rottweiler-hero.png`} alt="Rottweiler coordinating coding work across a terminal and agent tools" width="1536" height="1024" />
    <div class="hero-proof proof-one"><strong>Rust engine</strong><span>Headless by design</span></div>
    <div class="hero-proof proof-two"><strong>Durable sessions</strong><span>Resume, replay, export</span></div>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy
      if (!value) return
      await navigator.clipboard.writeText(value)
      button.textContent = "Copied"
      window.setTimeout(() => { button.textContent = "Copy" }, 1600)
    })
  }
</script>
